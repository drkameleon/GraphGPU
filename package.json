{
  "name": "graphgpu",
  "version": "0.3.2",
  "description": "Ultra-fast WebGPU graph visualization library",
  "author": "Yanis Zafirópulos <drkameleon>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "deno run --unstable-webgpu --unstable-sloppy-imports --allow-env --allow-read tests/gpu/smoke.ts",
    "bench": "tsx bench/run.ts",
    "bench:compare": "bash bench/ab.sh",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@webgpu/types": "^0.1.40",
    "happy-dom": "^21.0.4",
    "tinybench": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^5.1.2"
  },
  "keywords": [
    "graph",
    "visualization",
    "webgpu",
    "network",
    "nodes",
    "edges",
    "force-directed",
    "gpu",
    "performance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drkameleon/GraphGPU.git"
  },
  "engines": {
    "node": ">=18"
  }
}
